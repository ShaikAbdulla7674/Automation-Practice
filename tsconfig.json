{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",

    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node", "mocha"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force"
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}